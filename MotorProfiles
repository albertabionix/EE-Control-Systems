#include "main.h"
#include <math.h>
#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

/* Wiring: PA9 (TIM1_CH2) -> driver P (speed PWM)
           PA10 (TIM1_CH3) -> driver DIR
           GND -> driver G                                                    */

/* TIM1 counts 0..PWM_PERIOD. Clock is 4 MHz, so 4000 counts = 1 kHz PWM.
   Must match htim1.Init.Period (= PWM_TOP - 1) in MX_TIM1_Init.              */
#define PWM_TOP          4000U

/* Motor and gearbox constants from the profile document */
#define GEAR_RATIO       267.0f     /* motor turns per knee turn   */
#define KV_RPM_PER_V     268.0f     /* maxon EC 90 flat 607321     */
#define V_SUPPLY         12.0f

/* Speed scale. At 1.0 the profile asks for about 4.9x the speed the motor
   can reach on 12 V, so it must be scaled down.
     0.20 = profile peak sits just under 100 % duty
     0.05 = profile peak is about 25 % duty (first bench run)                 */
#define SCALE            0.05f

/* Hard ceiling on duty, 0..1. Applied after SCALE. */
#define DUTY_MAX         1.0f

/* Gait cycle length and update interval */
#define GAIT_PERIOD_MS   1000U
#define UPDATE_MS        10U        /* 100 Hz, as in the profile document */

/* 1 = coefficients re-solved so f(t) passes through the four data points
       (0.05,150) (0.25,-100) (0.60,300) (0.85,-350)
   0 = original coefficients from the document                              */
#define USE_CORRECTED_FIT 1

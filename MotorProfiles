/* USER CODE BEGIN 0 */

/* Knee angular velocity in deg/s. t is the fraction of the gait cycle, 0..1. */
float fourier_knee_velocity(float t){
    float two_pi  = 2.0f * (float)M_PI;
    float four_pi = 4.0f * (float)M_PI;

#if USE_CORRECTED_FIT
    float term1 =  200.93f * sinf(four_pi * t);
    float term2 =  154.01f * cosf(four_pi * t);
    float term3 =   54.01f * sinf(two_pi  * t);
    float term4 = -115.03f * cosf(two_pi  * t);
#else
    float term1 =  -47.75f * sinf(four_pi * t);
    float term2 =  232.25f * cosf(four_pi * t);
    float term3 =  147.57f * sinf(two_pi  * t);
    float term4 =  -67.75f * cosf(two_pi  * t);
#endif

    return term1 + term2 + term3 + term4;
}

/* Signed duty, nominally -1..1, from knee speed in deg/s.
   deg/s -> rpm is a divide by 6 (360 deg per rev, 60 s per min). */
float Duty_Val(float knee_deg_s){
    float knee_rpm  = knee_deg_s / 6.0f;
    float motor_rpm = knee_rpm * GEAR_RATIO;
    float duty      = SCALE * motor_rpm / (KV_RPM_PER_V * V_SUPPLY);
    return duty;
}

